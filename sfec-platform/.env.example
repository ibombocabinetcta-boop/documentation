# --- Odoo Online (API externe : plan Custom requis ; clé API dans Préférences > Sécurité du compte) ---
ODOO_URL=https://votre-entreprise.odoo.com
ODOO_DB=votre-entreprise
ODOO_LOGIN=utilisateur@exemple.com
ODOO_API_KEY=

# --- SFEC (https://docs.sfec.gouv.cg/api) ---
# mock = simulateur local | sandbox = https://sandbox.api.sfec.gouv.cg | production = https://api.sfec.gouv.cg
SFEC_MODE=mock
# Clé obtenue via une demande d'intégration « API (ERP) » sur le portail e-Facture, validée par la DGID
SFEC_API_KEY=
SFEC_TIMEOUT=30
# Facultatif : NIU du vendeur (le SFEC l'identifie déjà par la clé API)
SFEC_TAXPAYER_NIU=
# Facultatif : lieu de transaction imprimé sur la facture (ex. Pointe-Noire)
SFEC_TRANSACTION_LOCATION=
# Étiquette de contact Odoo désignant les clients « administration » (recipient_type=government)
SFEC_GOVERNMENT_TAG=Administration
# Mot-clé du nom de la taxe Odoo correspondant aux centimes additionnels
SFEC_CENT_TAX_KEYWORD=centime

# --- Plateforme ---
DATABASE_URL=sqlite:///./sfec.db
# Obligatoire hors mock : seules les factures datées de ce jour ou après sont envoyées (AAAA-MM-JJ)
SYNC_FROM_DATE=
# Si renseigné, les routes /api exigent l'en-tête X-API-Key
PLATFORM_API_KEY=
SYNC_BATCH_SIZE=50
MAX_ATTEMPTS=5
